# Environment variables (copy to .env)

POSTGRES_PASSWORD=change_me_to_a_random_string

# Docker Hub image (default: envisiontechai/fusionsyncai-email-verifier)
# APP_TAG=latest
# POSTGRES_TAG=postgres-16

# App
# APP_PORT=5050
# GUNICORN_WORKERS=4
# GUNICORN_TIMEOUT=300
# CHUNK_TICK_INTERVAL=15
# MAX_UPLOAD_SIZE_MB=50

# Optional — ngrok (use docker-compose.ngrok.yml)
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=https://your-reserved-name.ngrok-free.app
# PUBLIC_URL=https://your-reserved-name.ngrok-free.app
